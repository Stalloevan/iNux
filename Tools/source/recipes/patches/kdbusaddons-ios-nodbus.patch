diff --git a/src/kdbusservice_ios.cpp b/src/kdbusservice_ios.cpp
new file mode 100644
index 0000000..3c91dbb
--- /dev/null
+++ b/src/kdbusservice_ios.cpp
@@ -0,0 +1,82 @@
+/*
+    iNux: KDBusService on iOS.
+
+    There is no D-Bus on iOS, and the system already guarantees a single
+    running instance per app. KDBusService therefore registers nothing and
+    reports success, so apps that use it (most KDE apps, for single-instance
+    handling) start normally.
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+#include "kdbusservice.h"
+
+#include <QCoreApplication>
+#include <QVariant>
+
+class KDBusServicePrivate
+{
+public:
+    QString serviceName;
+    int exitValue = 0;
+};
+
+KDBusService::KDBusService(StartupOptions options, QObject *parent)
+    : QObject(parent)
+    , d(new KDBusServicePrivate)
+{
+    Q_UNUSED(options);
+    const QString domain = QCoreApplication::organizationDomain();
+    QString reversed;
+    if (!domain.isEmpty()) {
+        const QStringList parts = domain.split(QLatin1Char('.'), Qt::SkipEmptyParts);
+        for (auto it = parts.crbegin(); it != parts.crend(); ++it) {
+            reversed += *it + QLatin1Char('.');
+        }
+    }
+    d->serviceName = reversed + QCoreApplication::applicationName();
+}
+
+KDBusService::~KDBusService() = default;
+
+bool KDBusService::isRegistered() const
+{
+    return true;
+}
+
+QString KDBusService::serviceName() const
+{
+    return d->serviceName;
+}
+
+QString KDBusService::errorMessage() const
+{
+    return QString();
+}
+
+void KDBusService::setExitValue(int value)
+{
+    d->exitValue = value;
+}
+
+void KDBusService::unregister()
+{
+}
+
+void KDBusService::Activate(const QVariantMap &)
+{
+}
+
+void KDBusService::Open(const QStringList &, const QVariantMap &)
+{
+}
+
+void KDBusService::ActivateAction(const QString &, const QVariantList &, const QVariantMap &)
+{
+}
+
+int KDBusService::CommandLine(const QStringList &, const QString &, const QVariantMap &)
+{
+    return 0;
+}
+
+#include "moc_kdbusservice.cpp"
