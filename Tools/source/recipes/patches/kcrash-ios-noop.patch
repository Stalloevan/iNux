+/*
+    iNux: KCrash on iOS.
+
+    Desktop KCrash launches the DrKonqi crash reporter in a new process,
+    which iOS does not allow; iOS also records crashes itself. On iOS the
+    API is therefore kept but does nothing, so apps that call
+    KCrash::initialize() build and run unchanged.
+
+    SPDX-License-Identifier: LGPL-2.0-or-later
+*/
+#include "kcrash.h"
+
+#include <QHash>
+#include <QString>
+#include <QVariant>
+
+namespace KCrash
+{
+static HandlerType s_crashHandler = nullptr;
+static HandlerType s_emergencySaveFunction = nullptr;
+static bool s_drkonqiEnabled = false;
+
+void initialize()
+{
+}
+
+void defaultCrashHandler(int)
+{
+}
+
+void setCrashHandler(HandlerType handler)
+{
+    s_crashHandler = handler;
+}
+
+HandlerType crashHandler()
+{
+    return s_crashHandler;
+}
+
+void setEmergencySaveFunction(HandlerType saveFunction)
+{
+    s_emergencySaveFunction = saveFunction;
+}
+
+HandlerType emergencySaveFunction()
+{
+    return s_emergencySaveFunction;
+}
+
+void setFlags(KCrash::CrashFlags)
+{
+}
+
+void setDrKonqiEnabled(bool enabled)
+{
+    s_drkonqiEnabled = enabled;
+}
+
+bool isDrKonqiEnabled()
+{
+    return s_drkonqiEnabled;
+}
+
+void setErrorMessage(const QString &)
+{
+}
+
+void setErrorTags(const QHash<QString, QString> &)
+{
+}
+
+void setErrorExtraData(const QHash<QString, QString> &)
+{
+}
+
+void setGPUData(const QVariantHash &)
+{
+}
+} // namespace KCrash
