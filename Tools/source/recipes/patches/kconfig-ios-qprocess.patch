diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index ab5ddc8..e4c48cf 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -6,8 +6,11 @@ if(KCONFIG_USE_QML)
     add_subdirectory(qml)
 endif()
 add_subdirectory(kconfig_compiler)
-add_subdirectory(kconf_update)
-add_subdirectory(kreadconfig)
+# iOS: no separate helper programs (no process spawning in the sandbox).
+if(NOT IOS)
+    add_subdirectory(kconf_update)
+    add_subdirectory(kreadconfig)
+endif()
 
 ecm_qt_install_logging_categories(
     EXPORT KCONFIG
diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index 98962bc..642c51d 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -55,10 +55,15 @@ ecm_generate_export_header(KF6ConfigCore
     EXCLUDE_DEPRECATED_BEFORE_AND_AT ${EXCLUDE_DEPRECATED_BEFORE_AND_AT}
 )
 
+if(IOS)
+    # iNux: kconf_update is not built on iOS (its only caller is #ifdef'd out).
+    target_compile_definitions(KF6ConfigCore PRIVATE KCONF_UPDATE_INSTALL_LOCATION="")
+else()
 target_compile_definitions(KF6ConfigCore
     PRIVATE
         KCONF_UPDATE_INSTALL_LOCATION="${KDE_INSTALL_FULL_LIBEXECDIR_KF}/$<TARGET_FILE_NAME:KF6::kconf_update>"
 )
+endif()
 
 target_include_directories(KF6ConfigCore
     INTERFACE "$<INSTALL_INTERFACE:${KDE_INSTALL_INCLUDEDIR_KF}/KConfig;${KDE_INSTALL_INCLUDEDIR_KF}/KConfigCore>"
